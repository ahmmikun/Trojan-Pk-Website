# HTTP headers for Netlify and Cloudflare Pages (this file is copied to the site root on build).
# Vercel uses vercel.json instead. GitHub Pages cannot set custom headers.
#
# CSP note: Next.js static export inlines a small hydration script and Framer Motion
# sets inline styles, so script-src/style-src need 'unsafe-inline'. Everything else is
# locked to the site's own origin. If you add third-party scripts, extend this policy.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Fingerprinted build assets never change, so cache them for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Brand assets and other images: cache for a day, revalidate after.
/brand/*
  Cache-Control: public, max-age=86400
