# Copy to .env.local for local builds, or set in your hosting provider's settings.
# The site has no backend, so there are no secrets. This is the only setting.

# Public base URL of the site (no trailing slash). Used for canonical URLs,
# sitemap.xml, robots.txt, Open Graph previews and structured data.
# Required for production builds on CI / Vercel / Netlify / Cloudflare Pages
# (the build stops with a clear error if it is missing).
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: allow a build without a public URL on CI (e.g. pull-request checks).
# Never set this for the production deployment.
# ALLOW_LOCALHOST_SITE_URL=1
